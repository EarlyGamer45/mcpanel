# -----------------------------------------------------------------------------
# Minecraft Hosting Platform - environment configuration
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# install.sh generates APP_KEY / BLIND_INDEX_KEY and the DB credentials.
# -----------------------------------------------------------------------------

APP_NAME="MCPanel Hosting"
APP_ENV=production
APP_DEBUG=false
# Public address of the site, written by deploy/install.sh / set-address.sh:
#   https://panel.example.com       domain with HTTPS (recommended)
#   http://panel.example.com        domain without HTTPS
#   http://203.0.113.10[:8080]      IP address over plain HTTP (testing, LAN)
#   http://[2001:db8::10]           IPv6 address (brackets required)
APP_URL=https://panel.example.com
APP_CURRENCY=EUR
APP_LOCALE=en
APP_TIMEZONE=Europe/Rome

# 32 random bytes, base64 encoded (install.sh: php -r "echo base64_encode(random_bytes(32));")
APP_KEY=
# Separate key used for blind indexes (HMAC-SHA256 of e-mail addresses).
BLIND_INDEX_KEY=

# database: mysql (production, MariaDB 11.8) or sqlite (local demo only)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mchosting
DB_USERNAME=mchosting
DB_PASSWORD=
# SQLite path (only when DB_DRIVER=sqlite)
DB_SQLITE_PATH=storage/database.sqlite

SESSION_NAME=mch_session
# Secure flag of the session cookie: true (HTTPS only), false, or auto
# (Secure when the request is HTTPS). Use true with HTTPS, auto for HTTP/IP.
SESSION_SECURE=true
# Path of the admin panel (obscure it in production, e.g. /ops-7f3a)
ADMIN_PATH=admin
# Comma separated CIDR/IP allow-list for the admin panel (empty = allow all)
ADMIN_IP_ALLOWLIST=

# --- Pterodactyl -------------------------------------------------------------
PTERODACTYL_URL=https://panel.example.com
# Application API key (ptla_...), permissions listed in docs/it/03-install-guide.md
PTERODACTYL_APP_KEY=
# Client API key (ptlc_...)
PTERODACTYL_CLIENT_KEY=
PTERODACTYL_TIMEOUT=20
PTERODACTYL_RETRIES=3
# default | 1.11 | 1.12 (auto-detected when empty)
PTERODACTYL_VERSION=

# --- Payments ----------------------------------------------------------------
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
BANK_IBAN=
BANK_HOLDER=
BANK_BIC=

# --- Mail --------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="MCPanel Hosting"

# --- Licensing ---------------------------------------------------------------
LICENSE_KEY=
# Ed25519 public key (base64, raw 32 bytes) shipped with the release
LICENSE_PUBLIC_KEY=
LICENSE_SERVER=
LICENSE_GRACE_DAYS=7
TELEMETRY_OPT_IN=false

# --- Antifraud / CAPTCHA -----------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
CLAMAV_SOCKET=

# --- Optional ----------------------------------------------------------------
SENTRY_DSN=
CLOUDFLARE_API_TOKEN=
BACKUP_S3_BUCKET=

# true only behind a trusted reverse proxy/load balancer: X-Forwarded-For
# (client IP) and X-Forwarded-Proto (HTTPS detection, HSTS, Secure cookie)
TRUST_PROXY=false

# --- Site address (managed by deploy/lib/address.sh, informational) ----------
# domain | ip
SITE_ADDRESS_MODE=domain
# letsencrypt | proxy | off
SITE_HTTPS_MODE=letsencrypt
SITE_HTTP_PORT=80
